{
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true
  },

  "Security": {
    "PasswordPepper": "development-pepper-do-not-use-in-production"
  },

  "JwtSettings": {
    "SecretKey": "development-only-jwt-signing-key-change-me-1234567890"
  },

  "Seed": {
    "AdminEmail": "admin@localhost",
    "AdminPassword": "Admin#12345",
    "AdminFullName": "System Administrator"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
